# MongoDB Atlas connection string (Settings > Database > Connect > Drivers)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/student-voting?appName=Cluster0

# Any long random string - used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# Cloudinary (Dashboard > Account Details) - used for candidate photo storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# --- Email / OTP verification (see utils/otp.js) ---
# SMTP creds used to send the signup verification code. If left blank, the
# code is just printed to the server console instead - handy for local dev
# without setting up real email.
#
# For Gmail: use an "App Password" (Google Account > Security > 2-Step
# Verification > App Passwords), NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional - restrict signup to one email domain, e.g. only allow Gmail
# addresses or your college's domain. Leave blank to allow any domain with
# valid MX records.
ALLOWED_EMAIL_DOMAIN=

# Optional - shown in the OTP email subject/body
APP_NAME=Student Voting System

# Optional - defaults shown
PORT=8080
NODE_ENV=development
