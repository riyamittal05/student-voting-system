<nav class="bg-navy-900 shadow-md relative z-20">

    <div class="container mx-auto px-4 sm:px-6">
        <div class="flex flex-wrap items-center justify-between gap-3 py-4">

            <!-- LOGO -->
            <a href="/" class="flex items-center gap-2 font-display text-xl font-semibold text-paper tracking-tight">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-seal text-white text-sm font-mono shadow-sm">SV</span>
                Voting System
            </a>

            <!-- ELECTION STATUS BADGE -->
            <% if(typeof electionStatus !== "undefined"){ %>
                <span class="text-xs font-mono font-semibold uppercase tracking-wide px-3 py-1 rounded-full border
                    <% if(electionStatus==='live'){ %> bg-sash-600/20 text-emerald-300 border-emerald-400/30
                    <% } else if(electionStatus==='upcoming'){ %> bg-amber-500/15 text-amber-300 border-amber-400/30
                    <% } else if(electionStatus==='closed'){ %> bg-white/10 text-white/70 border-white/20
                    <% } else { %> bg-white/10 text-white/80 border-white/20
                    <% } %>">
                    <% if(electionStatus==='live'){ %>● Voting Live
                    <% } else if(electionStatus==='upcoming'){ %>Voting Not Started
                    <% } else if(electionStatus==='closed'){ %>Voting Closed
                    <% } else { %>Voting Open
                    <% } %>
                </span>
            <% } %>

            <!-- RESULTS DECLARED BADGE -->
            <% if(typeof election !== "undefined" && election && election.resultsDeclared){ %>
                <a href="/results" class="text-xs font-mono font-semibold uppercase tracking-wide px-3 py-1 rounded-full bg-seal text-white hover:bg-seal-700 transition">
                    Results Declared
                </a>
            <% } %>

            <!-- NAV LINKS -->
            <div class="flex flex-wrap items-center gap-1 sm:gap-2 ml-auto">

                <!-- HOME -->
                <a href="/" class="text-sm font-medium text-white/80 hover:text-white transition px-3 py-2">
                    Home
                </a>

                <!-- RESULTS (any logged in user) -->
                <% if(currentUser){ %>
                    <a href="/results" class="text-sm font-medium text-white/80 hover:text-white transition px-3 py-2">
                        Results
                    </a>
                <% } %>

                <!-- ADMIN ONLY -->
                <% if(currentUser && currentUser.role==="admin" ){ %>

                    <!-- DASHBOARD -->
                    <a href="/admin"
                        class="text-sm font-semibold bg-seal text-white px-4 py-2 rounded-lg hover:bg-seal-700 transition shadow-sm btn-lift">
                        Dashboard
                    </a>

                    <!-- ADD CANDIDATE -->
                    <a href="/candidates/new"
                        class="text-sm font-semibold border border-white/25 text-white/90 px-4 py-2 rounded-lg hover:border-white/60 hover:text-white transition">
                        Add Candidate
                    </a>

                    <!-- ELECTION SETTINGS -->
                    <a href="/admin/election"
                        class="text-sm font-semibold border border-white/25 text-white/90 px-4 py-2 rounded-lg hover:border-white/60 hover:text-white transition">
                        Schedule
                    </a>

                    <!-- VOTERS -->
                    <a href="/admin/voters"
                        class="text-sm font-semibold border border-white/25 text-white/90 px-4 py-2 rounded-lg hover:border-white/60 hover:text-white transition">
                        Voters
                    </a>

                    <!-- MANAGE ADMINS -->
                    <a href="/admin/users"
                        class="text-sm font-semibold border border-white/25 text-white/90 px-4 py-2 rounded-lg hover:border-white/60 hover:text-white transition">
                        Manage Admins
                    </a>

                <% } %>

                <!-- LOGOUT -->
                <% if(currentUser){ %>
                    <a href="/logout"
                        class="text-sm font-semibold text-white/70 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition">
                        Logout
                    </a>
                <% } else { %>

                    <!-- LOGIN -->
                    <a href="/login"
                        class="text-sm font-semibold border border-white/25 text-white/90 px-4 py-2 rounded-lg hover:border-white/60 hover:text-white transition">
                        Login
                    </a>

                    <!-- SIGNUP -->
                    <a href="/signup"
                        class="text-sm font-semibold bg-seal text-white px-4 py-2 rounded-lg hover:bg-seal-700 transition shadow-sm btn-lift">
                        Signup
                    </a>

                <% } %>

            </div>

        </div>
    </div>

    <!-- SITE-WIDE RESULTS DECLARED BANNER -->
    <% if(typeof election !== "undefined" && election && election.resultsDeclared){ %>
        <a href="/results"
            class="block bg-seal text-white text-center py-2.5 font-semibold text-sm hover:bg-seal-700 transition">
            🎉 Results have been declared — click to view the winners
        </a>
    <% } %>

</nav>
