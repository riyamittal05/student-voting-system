<!DOCTYPE html>
<html lang="en">

<head>
    <title>Manage Admins</title>
    <%- include("includes/head") %>
</head>

<body class="bg-paper min-h-screen">

    <%- include("includes/navbar") %>
    <%- include("includes/flash") %>

    <div class="max-w-5xl mx-auto px-6 py-10">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-subink mb-2">Access Control</p>
        <h1 class="font-display text-4xl font-semibold text-navy mb-2">Manage admins</h1>
        <p class="text-subink mb-8">Promote a trusted registered user to admin, or remove admin access.
            Only promote people you'd trust to see live vote counts and manage the election.</p>

        <div class="bg-panel border border-hairline rounded-xl shadow-sm overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-navy-50 text-navy font-mono text-xs uppercase tracking-wide">
                    <tr>
                        <th class="px-6 py-3">Username</th>
                        <th class="px-6 py-3">Email</th>
                        <th class="px-6 py-3">Role</th>
                        <th class="px-6 py-3">Verified</th>
                        <th class="px-6 py-3 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-hairline">
                    <% users.forEach((u) => { %>
                        <tr class="hover:bg-navy-50/40">
                            <td class="px-6 py-3 font-medium"><%= u.username %></td>
                            <td class="px-6 py-3 text-subink"><%= u.email %></td>
                            <td class="px-6 py-3">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold <%= u.role === 'admin' ? 'bg-navy-50 text-navy' : 'bg-gray-100 text-subink' %>">
                                    <%= u.role %>
                                </span>
                            </td>
                            <td class="px-6 py-3">
                                <% if(u.emailVerified){ %>
                                    <span class="text-sash-600 font-semibold">✓</span>
                                <% } else { %>
                                    <span class="text-subink">—</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-3 text-right">
                                <% if(u.role === "admin"){ %>
                                    <% if(String(u._id) !== String(currentUser._id)){ %>
                                        <form action="/admin/users/<%= u._id %>/demote" method="POST" class="inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button
                                                onclick="return confirm('Remove admin access from <%= u.username %>?')"
                                                class="bg-seal-50 text-seal-700 border border-seal/20 px-4 py-2 rounded-lg hover:bg-seal-50/70 transition text-sm font-semibold">
                                                Remove admin
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-xs text-subink">(you)</span>
                                    <% } %>
                                <% } else { %>
                                    <form action="/admin/users/<%= u._id %>/promote" method="POST" class="inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button
                                            onclick="return confirm('Make <%= u.username %> an admin? They will be able to manage candidates, the election schedule, and see live results.')"
                                            class="bg-navy text-white px-4 py-2 rounded-lg hover:bg-navy-700 transition text-sm font-semibold">
                                            Make admin
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <p class="text-sm text-subink mt-6">
            Need to create the very first admin, or one for someone without an account yet? Run this on the server:
            <code class="bg-navy-50 text-navy px-2 py-1 rounded font-mono text-xs">node scripts/createAdmin.js &lt;email&gt; &lt;password&gt; [username]</code>
        </p>
    </div>

</body>

</html>
